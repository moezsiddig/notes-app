<%- include('../partials/header', { title: 'My Notes' }) %>

<div class="main-container">

    <h1 class="page-title">My Notes</h1>

    <p class="welcome">Welcome, <strong><%= user.username %></strong>!</p>

    <div class="actions">
        <a href="/notes/new" class="btn btn-primary">+ Add New Note</a>
        <a href="/logout" class="btn btn-secondary">Logout</a>
    </div>

    <% if (typeof error !== 'undefined') { %>
        <div class="error-msg"><%= error %></div>
    <% } %>

    <% if (notes.length === 0) { %>
        <div class="empty-state">
            <p>No notes yet.</p>
            <p>Click "Add New Note" to create your first one!</p>
        </div>
    <% } else { %>
        <% notes.forEach(function(note) { %>
            <div class="note-card">
                <h2><%= note.title %></h2>
                <p><%= note.content %></p>
                <small>Created: <%= note.createdAt.toDateString() %></small>

                <div class="note-card-actions">
                    <a href="/notes/<%= note._id %>/edit" class="btn btn-primary">Edit</a>

                    <form action="/notes/<%= note._id %>/delete" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this note?')">Delete</button>
                    </form>
                </div>
            </div>
        <% }); %>
    <% } %>

</div>

<%- include('../partials/footer') %>